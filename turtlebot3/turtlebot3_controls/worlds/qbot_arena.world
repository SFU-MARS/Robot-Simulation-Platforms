<?xml version="1.0"?>
<sdf version="1.6">
  <world name="qbot_arena">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.9 0.9 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <!-- 3.6 m x 3.6 m floor; its top surface is at z = 0. -->
    <model name="map_floor">
      <static>true</static>
      <link name="floor">
        <collision name="floor_collision">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>3.8000000000000003 3.8000000000000003 0.05</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>3.8000000000000003 3.8000000000000003 0.05</size></box></geometry>
          <material><ambient>0.82 0.82 0.82 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wall_n: x = [-1.850, 1.850], y = [1.800, 1.850]; perimeter -->
    <model name="wall_n">
      <static>true</static>
      <pose>0.0000 1.8250 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>3.7000 0.0500 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.7000 0.0500 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wall_s: x = [-1.850, 1.850], y = [-1.850, -1.800]; perimeter -->
    <model name="wall_s">
      <static>true</static>
      <pose>0.0000 -1.8250 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>3.7000 0.0500 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.7000 0.0500 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wall_w: x = [-1.850, -1.800], y = [-1.800, 1.800]; perimeter -->
    <model name="wall_w">
      <static>true</static>
      <pose>-1.8250 0.0000 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.0500 3.6000 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0500 3.6000 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wall_e: x = [1.800, 1.850], y = [-1.800, 1.800]; perimeter -->
    <model name="wall_e">
      <static>true</static>
      <pose>1.8250 0.0000 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.0500 3.6000 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.0500 3.6000 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- l_bottom: x = [-0.200, 0.600], y = [-0.300, -0.200]; L-shaped obstacle in the middle, with l_side: a concave corner open to the upper left; 1.2 m or more to the walls -->
    <model name="l_bottom">
      <static>true</static>
      <pose>0.2000 -0.2500 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.8000 0.1000 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8000 0.1000 0.4</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- l_side: x = [0.500, 0.600], y = [-0.200, 0.600]; L-shaped obstacle -->
    <model name="l_side">
      <static>true</static>
      <pose>0.5500 0.2000 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.1000 0.8000 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1000 0.8000 0.4</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- pillar_1: x = [-1.050, -0.750], y = [0.750, 1.050]; pillar near the north-west corner (the corner itself is closed: 0.75 m to the walls), 1.1 m from the L -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-0.9000 0.9000 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.3000 0.3000 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3000 0.3000 0.4</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
