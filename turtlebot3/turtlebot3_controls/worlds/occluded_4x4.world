<?xml version="1.0"?>
<sdf version="1.6">
  <world name="occluded_4x4">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.9 0.9 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <!-- A 4 m x 4 m floor; its top surface is at z=0. -->
    <model name="map_floor">
      <static>true</static>
      <link name="floor">
        <collision name="floor_collision">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>4 4 0.05</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>4 4 0.05</size></box></geometry>
          <material><ambient>0.82 0.82 0.82 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wall_n: x=[-2.02, 2.02], y=[2, 2.05]; perimeter. -->
    <model name="wall_n">
      <static>true</static>
      <pose>0.0 2.025 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>4.05 0.05 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.05 0.05 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wall_s: x=[-2.02, 2.02], y=[-2.05, -2]; perimeter. -->
    <model name="wall_s">
      <static>true</static>
      <pose>0.0 -2.025 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>4.05 0.05 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.05 0.05 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wall_w: x=[-2.05, -2], y=[-2, 2]; perimeter. -->
    <model name="wall_w">
      <static>true</static>
      <pose>-2.025 0.0 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.05 4.0 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 4.0 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wall_e: x=[2, 2.05], y=[-2, 2]; perimeter. -->
    <model name="wall_e">
      <static>true</static>
      <pose>2.025 0.0 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.05 4.0 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 4.0 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- screen_1: x=[-1.2, 0.2], y=[-0.9, -0.8]; screen; hidden_1 sits behind its east end. -->
    <model name="screen_1">
      <static>true</static>
      <pose>-0.5 -0.85 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>1.4 0.1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.1 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- hidden_1: x=[0.35, 0.55], y=[-0.65, -0.45]; hidden behind screen_1 from the south-west. -->
    <model name="hidden_1">
      <static>true</static>
      <pose>0.45 -0.55 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.2 0.2 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- screen_2: x=[-0.2, 1.2], y=[0.3, 0.4]; screen; hidden_2 sits behind its west end. -->
    <model name="screen_2">
      <static>true</static>
      <pose>0.5 0.35 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>1.4 0.1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.1 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- hidden_2: x=[-0.55, -0.35], y=[0.55, 0.75]; hidden behind screen_2 from the east. -->
    <model name="hidden_2">
      <static>true</static>
      <pose>-0.45 0.65 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.2 0.2 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- screen_3: x=[-1.25, -1.15], y=[0.55, 1.45]; screen; hidden_3 sits behind its south end. -->
    <model name="screen_3">
      <static>true</static>
      <pose>-1.2 1.0 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.1 0.9 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.9 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- hidden_3: x=[-1.05, -0.85], y=[0.25, 0.45]; hidden behind screen_3 from the north-west. -->
    <model name="hidden_3">
      <static>true</static>
      <pose>-0.95 0.35 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.2 0.2 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- pillar_1: x=[1.15, 1.45], y=[-1.45, -1.15]; free-standing. -->
    <model name="pillar_1">
      <static>true</static>
      <pose>1.3 -1.3 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- pillar_2: x=[1.2, 1.4], y=[1.1, 1.5]; free-standing. -->
    <model name="pillar_2">
      <static>true</static>
      <pose>1.3 1.3 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.2 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.4 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- pillar_3: x=[-1.45, -1.15], y=[-1.55, -1.25]; free-standing. -->
    <model name="pillar_3">
      <static>true</static>
      <pose>-1.3 -1.4 0.2 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 7 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
